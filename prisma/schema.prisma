generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Dapur {
  id         String     @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name       String     @db.VarChar(255)
  logo_url   String?    @db.Text
  created_at DateTime   @default(now()) @db.Timestamp(0)
  updated_at DateTime   @default(now()) @db.Timestamp(0)
  menu_items MenuItem[]

  @@index([name], map: "idx_dapurs_name")
  @@map("dapurs")
}

model MenuItem {
  id           String        @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name         String        @db.VarChar(255)
  description  String?       @db.Text
  price        Decimal       @db.Decimal(12, 2)
  photo_url    String?       @db.Text
  category       String        @db.VarChar(100)
  product_type   String        @default("fnb") @db.VarChar(20)
  stock_status   String        @default("aktif") @db.VarChar(20)
  use_stock      Boolean       @default(false)
  stock_quantity Int           @default(0)
  discount_price Decimal?      @db.Decimal(12, 2)
  dapur_id       String        @db.Char(36)
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  updated_at     DateTime      @default(now()) @updatedAt @db.Timestamp(0)
  cart_items   cart_items[]
  dapur        Dapur         @relation(fields: [dapur_id], references: [id], onUpdate: Restrict, map: "fk_menu_items_dapur")
  order_items  order_items[]

  @@index([dapur_id], map: "fk_menu_items_dapur")
  @@index([category], map: "idx_menu_items_category")
  @@index([product_type], map: "idx_menu_items_product_type")
  @@index([name], map: "idx_menu_items_name")
  @@index([stock_status], map: "idx_menu_items_stock_status")
  @@map("menu_items")
}

model cart_items {
  id           String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  user_id      String   @db.Char(36)
  menu_item_id String   @db.Char(36)
  qty          Int      @default(1)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_items_ibfk_1")
  menu_items   MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_items_ibfk_2")

  @@unique([user_id, menu_item_id], map: "uq_cart_user_menu")
  @@index([user_id], map: "idx_cart_items_user_id")
  @@index([menu_item_id], map: "menu_item_id")
}

model categories {
  id         String    @id @db.VarChar(255)
  name       String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model menus {
  id           String    @id @db.VarChar(255)
  category_id  String    @db.VarChar(255)
  name         String    @db.VarChar(255)
  description  String?   @db.Text
  price        Float     @db.Float
  image        String?   @db.VarChar(255)
  is_available Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(0)
}

model order_items {
  id             String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  order_id       String   @db.Char(36)
  menu_item_id   String   @db.Char(36)
  qty            Int
  price_at_order Decimal  @db.Decimal(12, 2)
  orders         orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_items_ibfk_1")
  menu_items     MenuItem @relation(fields: [menu_item_id], references: [id], onUpdate: Restrict, map: "order_items_ibfk_2")

  @@index([order_id], map: "idx_order_items_order_id")
  @@index([menu_item_id], map: "menu_item_id")
}

model orders {
  id                     String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  display_id             String?                 @db.VarChar(50)
  user_id                String                  @db.Char(36)
  order_type             String                  @db.VarChar(20)
  dine_in_date           DateTime?               @db.Date
  dine_in_time           String?                 @db.VarChar(5)
  total_price            Decimal                 @db.Decimal(12, 2)
  status                 String                  @default("menunggu_pembayaran") @db.VarChar(30)
  payment_proof_url      String?                 @db.Text
  created_at             DateTime                @default(now()) @db.Timestamp(0)
  updated_at             DateTime                @default(now()) @db.Timestamp(0)
  ravapay_transaction_id String?                 @db.VarChar(100)
  ravapay_qr_url         String?                 @db.Text
  order_items            order_items[]
  users                  users                   @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "orders_ibfk_1")
  payment_verifications  payment_verifications[]

  @@index([created_at(sort: Desc)], map: "idx_orders_created_at")
  @@index([display_id], map: "idx_orders_display_id")
  @@index([order_type], map: "idx_orders_order_type")
  @@index([ravapay_transaction_id], map: "idx_orders_ravapay_tx")
  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user_id")
}

model payment_verifications {
  id               String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  order_id         String   @db.Char(36)
  verified_by      String   @db.Char(36)
  status           String   @db.VarChar(20)
  rejection_reason String?  @db.Text
  verified_at      DateTime @default(now()) @db.Timestamp(0)
  orders           orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "payment_verifications_ibfk_1")
  users            users    @relation(fields: [verified_by], references: [id], onUpdate: Restrict, map: "payment_verifications_ibfk_2")

  @@index([order_id], map: "idx_payment_verifications_order_id")
  @@index([verified_by], map: "verified_by")
}

model users {
  id                    String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name                  String                  @db.VarChar(255)
  email                 String                  @unique(map: "email") @db.VarChar(255)
  password_hash         String?                 @db.Text
  google_id             String?                 @db.VarChar(255)
  phone_number          String?                 @db.VarChar(20)
  role                  String                  @default("pelanggan") @db.VarChar(20)
  nuasama_point         Int                     @default(0)
  created_at            DateTime                @default(now()) @db.Timestamp(0)
  updated_at            DateTime                @default(now()) @db.Timestamp(0)
  cart_items            cart_items[]
  orders                orders[]
  payment_verifications payment_verifications[]
  user_vouchers         user_vouchers[]

  @@index([email], map: "idx_users_email")
  @@index([google_id], map: "idx_users_google_id")
}

model app_settings {
  id         String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  key        String   @unique @db.VarChar(50)
  value      String   @db.Text
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@index([key], map: "idx_app_settings_key")
}

model vouchers {
  id                    String         @id @default(dbgenerated("(uuid())")) @db.Char(36)
  code                  String         @unique @db.VarChar(50)
  discount_amount       Decimal        @db.Decimal(12, 2)
  applicable_product    String         @default("all") @db.VarChar(20)
  applicable_order_type String         @default("all") @db.VarChar(20)
  min_purchase          Decimal        @default(0) @db.Decimal(12, 2)
  point_cost            Int            @default(0)
  is_active             Boolean        @default(true)
  created_at            DateTime       @default(now()) @db.Timestamp(0)
  updated_at            DateTime       @default(now()) @updatedAt @db.Timestamp(0)
  user_vouchers         user_vouchers[]

  @@index([code], map: "idx_vouchers_code")
}

model user_vouchers {
  id          String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  user_id     String   @db.Char(36)
  voucher_id  String   @db.Char(36)
  is_used     Boolean  @default(false)
  used_at     DateTime?
  claimed_at  DateTime @default(now()) @db.Timestamp(0)

  users    users    @relation(fields: [user_id], references: [id])
  vouchers vouchers @relation(fields: [voucher_id], references: [id])

  @@index([user_id], map: "idx_user_vouchers_user")
  @@index([voucher_id], map: "idx_user_vouchers_voucher")
}
