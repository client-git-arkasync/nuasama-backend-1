# =============================================
# SERVER
# =============================================
PORT=5000
NODE_ENV=development

# =============================================
# DATABASE (PostgreSQL/MySQL)
# =============================================
DATABASE_URL="mysql://user:password@localhost:3306/dbname"

# =============================================
# REDIS
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# JWT
# =============================================
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
JWT_EXPIRES_IN=2160h

# =============================================
# GOOGLE OAUTH 2.0
# =============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:5000/auth/google/callback

# =============================================
# STORAGE
# =============================================
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://...
STORAGE_BASE_URL=https://res.cloudinary.com/...
STORAGE_PATH=./uploads

# =============================================
# EMAIL NOTIFIKASI
# =============================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=user@domain.com
SMTP_PASSWORD=secret
SMTP_FROM=notification@nuasama.com

# =============================================
# RATE LIMITER
# =============================================
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1m

# =============================================
# CORS
# =============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================
# RAVAPAY PAYMENT GATEWAY
# =============================================
RAVAPAY_API_KEY=your_ravapay_api_key
RAVAPAY_PROVIDER=sandbox
RAVAPAY_WEBHOOK_SECRET=your_ravapay_webhook_secret
